    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
